{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CODEX_PLUGIN_ROOT') or os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','advisor_gate.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Task|Agent|.*consult_advisor)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CODEX_PLUGIN_ROOT') or os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','advisor_marker.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CODEX_PLUGIN_ROOT') or os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','advisor_cleanup.py'),run_name='__main__')\""
          },
          {
            "type": "command",
            "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ.get('CODEX_PLUGIN_ROOT') or os.environ['CLAUDE_PLUGIN_ROOT'],'hooks','advisor_context.py'),run_name='__main__')\""
          }
        ]
      }
    ]
  }
}
