{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,sys,runpy; d=os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks'); sys.path.insert(0,d); runpy.run_path(os.path.join(d,'critic_gate.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*consult_critic$",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,sys,runpy; d=os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks'); sys.path.insert(0,d); runpy.run_path(os.path.join(d,'critic_marker.py'),run_name='__main__')\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import os,sys,runpy; d=os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks'); sys.path.insert(0,d); runpy.run_path(os.path.join(d,'critic_cleanup.py'),run_name='__main__')\""
          },
          {
            "type": "command",
            "command": "python -c \"import os,sys,runpy; d=os.path.join(os.environ['CLAUDE_PLUGIN_ROOT'],'hooks'); sys.path.insert(0,d); runpy.run_path(os.path.join(d,'critic_context.py'),run_name='__main__')\""
          }
        ]
      }
    ]
  }
}
