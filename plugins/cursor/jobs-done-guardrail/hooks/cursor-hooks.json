{
  "version": 1,
  "hooks": {
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/stop-jobs-done-guardrail.ps1",
        "timeout": 600,
        "loop_limit": 10
      }
    ],
    "sessionStart": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./hooks/notify-online.ps1",
        "failClosed": false
      }
    ]
  }
}
